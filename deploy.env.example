# Kopie als "deploy.env" anlegen (wird nicht versioniert) und ausfuellen.
# Echte Umgebungsvariablen haben Vorrang vor den Werten hier.

# itch.io -> Settings -> API keys -> Generate new API key
BUTLER_API_KEY=

# Ziel auf itch.io: <benutzer>/<projekt-slug>. Ueberschreibt den Default
# "melleeee/arcane-defense" aus deploy_itch.ps1.
ITCH_TARGET=melleeee/arcane-defense

# Optional: Pfad zur Godot-*_console.exe, falls die Autoerkennung
# (Downloads, %LOCALAPPDATA%\Programs, C:\Program Files\Godot, C:\Godot) nicht greift.
GODOT_PATH=
